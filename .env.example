# LearnHub LMS Environment Configuration Example

# Server Port (AI Studio container requires port 3000)
PORT=3000

# Authentication Secret (random key used to sign JWT sessions)
JWT_SECRET=

# Google Gemini API Key for Server-Side AI Tutor Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Database Configuration (Optional: defaults to local JSON file persistence in data/database.json)
# Note: AI Studio sandbox blocks external direct TCP connections.
MONGODB_URI=
MONGODB_DB=learnhub
